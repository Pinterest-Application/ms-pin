<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="create-pin-like-table" author="pin_user">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="pin_like"/>
            </not>
        </preConditions>

        <createTable tableName="pin_like">
            <column name="id" type="uuid" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_pin_like_id"/>
            </column>

            <column name="pin_id" type="uuid">
                <constraints nullable="false"
                             foreignKeyName="fk_pin_like_pin_id"
                             references="pin(id)"
                             deleteCascade="true"/>
            </column>

            <column name="user_id" type="uuid">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="timestamp with time zone" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="pin_like"
                             columnNames="pin_id, user_id"
                             constraintName="uq_pin_like_pin_user"/>

        <createIndex indexName="idx_pin_like_user_id" tableName="pin_like">
            <column name="user_id"/>
        </createIndex>

        <rollback>
            <dropTable tableName="pin_like"/>
        </rollback>
    </changeSet>

</databaseChangeLog>